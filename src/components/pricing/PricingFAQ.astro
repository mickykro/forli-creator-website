---
import T from '../T.astro';
import { WHATSAPP_QUESTION_URL } from '../../brand';

const faqs = [
  {
    questionHe: 'איך עובדים קרדיטים?',
    questionEn: 'How do credits work?',
    answerHe: 'קרדיטים הם המטבע של פורלי. הקמת דף נכס צורכת כ-100 קרדיטים, כתיבת טקסט שיווקי כ-250, וסיור וידאו כ-500. תוכלו לראות את היתרה שלכם באזור הניהול בכל עת.',
    answerEn: 'Credits are Forly\'s currency. Creating a property page uses ~100 credits, marketing copy ~250, and a video tour ~500. You can view your balance in the dashboard at any time.',
  },
  {
    questionHe: 'האם יש הגבלה על כמות דפי הנכס שאפשר להקים?',
    questionEn: 'Is there a limit on property pages?',
    answerHe: 'לא. כל המסלולים שלנו כוללים הקמה של דפי נכס ללא הגבלה. אתם משלמים רק על יצירת תוכן מיוחד כמו סיורי וידאו וקופירייטינג שיווקי AI.',
    answerEn: 'No. All our plans include unlimited property pages. You only use credits for generating special content like video tours and AI marketing copy.',
  },
  {
    questionHe: 'האם קרדיטים פגים?',
    questionEn: 'Do credits expire?',
    answerHe: 'קרדיטים במסלולים החודשיים מתחדשים בכל חודש ולא עוברים לחודש הבא. קרדיטים בחבילות חד-פעמיות תקפים ל-12 חודשים מרגע הרכישה.',
    answerEn: 'Credits in monthly plans reset each month and don\'t roll over. Credits from one-time packs are valid for 12 months from purchase.',
  },
  {
    questionHe: 'אפשר לבטל בכל רגע?',
    questionEn: 'Can I cancel anytime?',
    answerHe: 'כן, אין התחייבות. אפשר לבטל את המסלול החודשי בכל רגע דרך אזור הניהול, בוואטסאפ או במייל. הביטול ייכנס לתוקף בתום תקופת החיוב הנוכחית.',
    answerEn: 'Yes, no commitment. You can cancel your monthly plan anytime via the dashboard, WhatsApp, or email. Cancellation takes effect at the end of the current billing period.',
  },
  {
    questionHe: 'האם דפי הנכס ירדו מהאוויר אם אבטל?',
    questionEn: 'Will my property pages go offline if I cancel?',
    answerHe: 'דפי הנכס יישארו באוויר עד תום 30 הימים מהקמתם או עד סיום המנוי שלכם, המאוחר מביניהם. לא ניתן להאריך תוקף של דפים ללא מנוי פעיל.',
    answerEn: 'Property pages will remain live until their 30-day expiry or the end of your subscription, whichever is later. Pages cannot be extended without an active subscription.',
  },
];
---

<section class="pricing-faq" id="pricing-faq" data-pricing-faq>
  <div class="container">
    <header class="faq-header">
      <h2 class="faq-title">
        <T he="שאלות נפוצות על מחירים" en="Pricing FAQ" />
      </h2>
      <p class="faq-sub">
        <T he="התשובות לכל מה שרציתם לדעת על תשלומים וקרדיטים" en="Answers to everything you wanted to know about payments and credits" />
      </p>
    </header>

    <div class="faq-list">
      {faqs.map((faq, i) => (
        <details class="faq-item" {...(i === 0 ? { open: true } : {})}>
          <summary>
            <T he={faq.questionHe} en={faq.questionEn} />
          </summary>
          <p>
            <span class="l-he">{faq.answerHe}</span>
            <span class="l-en">{faq.answerEn}</span>
          </p>
        </details>
      ))}
    </div>

    <div class="faq-cta">
      <p><T he="יש שאלה נוספת?" en="Have another question?" /></p>
      <a href={WHATSAPP_QUESTION_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
        <T he="שאלו אותנו בוואטסאפ" en="Ask us on WhatsApp" />
      </a>
    </div>
  </div>
</section>

<style>
  .pricing-faq {
    padding: 80px 0;
    background: var(--surface);
  }

  .faq-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .faq-title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .faq-sub {
    font-size: 16px;
    color: var(--ink-soft);
    max-width: 500px;
    margin: 0 auto;
  }

  .faq-list {
    display: grid;
    gap: 12px;
    max-width: 800px;
    margin: 0 auto 40px;
  }

  .faq-item {
    border: 1px solid var(--line);
    background: var(--surface-soft);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .faq-item[open] {
    border-color: rgba(219, 107, 151, 0.35);
    box-shadow: 0 4px 24px rgba(219, 107, 151, 0.08);
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--forli-pink-deep);
    transition: transform 0.2s ease;
    font-size: 20px;
    line-height: 1;
    flex-shrink: 0;
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p {
    margin: 14px 0 0;
    color: var(--ink-soft);
    line-height: 1.7;
    font-size: 15px;
  }

  .faq-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .faq-cta p {
    font-size: 15px;
    color: var(--ink-soft);
  }
</style>
