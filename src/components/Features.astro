---
import T from './T.astro';
import RadialOrbitalTimeline, { type TimelineItem } from './RadialOrbitalTimeline.astro';

// 6 capabilities Forly ships. Each node is a distinct generation pipeline.
// Connections show which capabilities pair up: image ↔ image-edit,
// video ↔ image-to-video, plus carousels/websites that compose the others.
const processSteps: TimelineItem[] = [
  {
    id: 1,
    iconKey: 'website',
    he: {
      title: 'דפי נכס באוויר',
      date: 'תוך דקות',
      content: 'מזינים פרטים בוואטסאפ או במערכת, ותוך דקות יש לנכס דף נחיתה מעוצב עם וידאו, גלריה ומידע על השכונה.',
    },
    en: {
      title: 'Live property pages',
      date: 'In minutes',
      content: 'Enter details in WhatsApp or the dashboard, and within minutes your listing has a landing page with video, gallery, and neighborhood info.',
    },
    status: 'completed',
    relatedIds: [2, 5],
    progress: 100,
  },
  {
    id: 2,
    iconKey: 'video',
    he: {
      title: 'וידאו לכל נכס',
      date: 'אוטומטי או שלכם',
      content: 'פורלי יוצרת סיור וידאו מבוסס AI מהתמונות שלכם, או שפשוט תעלו סיור וידאו שצילמתם בעצמכם.',
    },
    en: {
      title: 'Video for every listing',
      date: 'Auto or manual',
      content: 'Forly generates an AI video tour from your photos, or you can simply upload a video tour you shot yourself.',
    },
    status: 'completed',
    relatedIds: [1],
    progress: 100,
  },
  {
    id: 3,
    iconKey: 'carousel',
    he: {
      title: 'ניהול לידים',
      date: 'ישר לוואטסאפ',
      content: 'כל ליד שמגיע מדף הנכס נשלח אליכם מיד לוואטסאפ עם כל הפרטים, כדי שתוכלו לסגור עסקה בזמן אמת.',
    },
    en: {
      title: 'Lead management',
      date: 'Straight to WhatsApp',
      content: 'Every lead from your property page is sent instantly to your WhatsApp with all details, so you can close in real time.',
    },
    status: 'completed',
    relatedIds: [4],
    progress: 100,
  },
  {
    id: 4,
    iconKey: 'image-edit',
    he: {
      title: 'עריכה חכמה',
      date: 'שליטה מלאה',
      content: 'שנו מחיר, החליפו תמונות, או עדכנו את הטקסט השיווקי מתוך אזור הניהול שלכם - השינויים באוויר מיד.',
    },
    en: {
      title: 'Smart editing',
      date: 'Full control',
      content: 'Change the price, swap photos, or update the marketing copy from your dashboard - changes are live instantly.',
    },
    status: 'completed',
    relatedIds: [3],
    progress: 100,
  },
  {
    id: 5,
    iconKey: 'clock',
    he: {
      title: 'מעקב תוקף',
      date: 'התראות חכמות',
      content: 'דפי נכס פעילים ל-30 יום. פורלי שולחת לכם תזכורת 5 ימים לפני הסיום, עם כפתור אחד להארכה בחינם.',
    },
    en: {
      title: 'Expiry tracking',
      date: 'Smart alerts',
      content: 'Pages are live for 30 days. Forly sends you a reminder 5 days before expiry, with a one-tap free extension link.',
    },
    status: 'completed',
    relatedIds: [1, 6],
    progress: 100,
  },
  {
    id: 6,
    iconKey: 'spark',
    he: {
      title: 'קופירייטינג AI',
      date: 'טקסטים שמוכרים',
      content: 'ה-AI שלנו כותב את כותרות הגיבור, הטקסט השיווקי, ונקודות העניין של השכונה עבור כל נכס שלכם.',
    },
    en: {
      title: 'AI Copywriting',
      date: 'Text that sells',
      content: 'Our AI writes the hero headlines, marketing copy, and neighborhood highlights for every listing you upload.',
    },
    status: 'completed',
    relatedIds: [5, 1, 3],
    progress: 100,
  },
];

const cards = [
  {
    label: { he: 'הודעה → דף נכס', en: 'Message → Property Page' },
    title: { he: 'דף נחיתה ממשפט אחד', en: 'Landing page from a sentence' },
    body: {
      he: 'שלחו "דירת 4 חדרים בהרצל 15". פורלי מקימה דף נכס מעוצב עם פרטים, גלריה וטופס לידים, וחוזרת אליכם עם קישור מוכן.',
      en: 'Send "4 room apartment at 15 Herzl". Forly builds a designed property page with details, gallery, and a lead form, returning a live link.',
    },
    metric: 100,
    metricLabel: { he: 'דף נכס באוויר', en: 'Live property page' },
  },
  {
    label: { he: 'תמונות → וידאו', en: 'Photos → Video' },
    title: { he: 'סיור וידאו אוטומטי', en: 'Automatic video tours' },
    body: {
      he: 'העלו את התמונות של הנכס, ופורלי תהפוך אותן לסיור וידאו מקצועי שמשולב אוטומטית בדף הנכס שלכם.',
      en: 'Upload your property photos, and Forly turns them into a professional video tour that is automatically embedded in your page.',
    },
    metric: 96,
    metricLabel: { he: 'המרת תמונות לוידאו', en: 'Photos to video' },
  },
  {
    label: { he: 'לידים → וואטסאפ', en: 'Leads → WhatsApp' },
    title: { he: 'כל ליד אצלכם בנייד', en: 'Every lead on your phone' },
    body: {
      he: 'ברגע שלקוח פוטנציאלי משאיר פרטים בדף הנכס, אתם מקבלים הודעת וואטסאפ עם השם והטלפון שלו, עם כפתור לחיוג מהיר.',
      en: 'The moment a prospect leaves their details on the property page, you get a WhatsApp message with their name and phone, ready to call.',
    },
    metric: 100,
    metricLabel: { he: 'זמן הגעת ליד', en: 'Lead delivery time' },
  },
  {
    label: { he: 'שליטה מלאה', en: 'Full Control' },
    title: { he: 'עריכה בזמן אמת', en: 'Real-time editing' },
    body: {
      he: 'המחיר ירד? התמונות התעדכנו? היכנסו לאזור הניהול, שנו את הפרטים בטופס פשוט, והדף מתעדכן באותו רגע.',
      en: 'Price dropped? New photos? Log into the dashboard, change the details in a simple form, and the page updates instantly.',
    },
    metric: 90,
    metricLabel: { he: 'זמן עדכון באוויר', en: 'Live update time' },
  },
  {
    label: { he: 'קופירייטינג AI', en: 'AI Copywriting' },
    title: { he: 'טקסטים שמוכרים', en: 'Text that sells' },
    body: {
      he: 'ה-AI שלנו כותב את כותרות הגיבור, הטקסט השיווקי, ונקודות העניין של השכונה עבור כל נכס שלכם באופן אוטומטי.',
      en: 'Our AI automatically writes the hero headlines, marketing copy, and neighborhood highlights for every listing you upload.',
    },
    metric: 100,
    metricLabel: { he: 'יצירת טקסט שיווקי', en: 'Marketing copy generation' },
  },
  {
    label: { he: 'מעקב תוקף', en: 'Expiry tracking' },
    title: { he: 'התראות חכמות', en: 'Smart alerts' },
    body: {
      he: 'דפי נכס פעילים ל-30 יום. פורלי שולחת לכם תזכורת 5 ימים לפני הסיום, עם כפתור אחד להארכה בחינם.',
      en: 'Pages are live for 30 days. Forly sends you a reminder 5 days before expiry, with a one-tap free extension link.',
    },
    metric: 100,
    metricLabel: { he: 'הארכה בחינם', en: 'Free extension' },
  },
];

type StatAccent = 'pink' | 'violet' | 'amber' | 'sage';
type StatIcon = 'spark' | 'palette' | 'clock' | 'globe';
const stats: {
  value: number;
  suffix: string;
  accent: StatAccent;
  icon: StatIcon;
  he: string;
  en: string;
}[] = [
  { value: 6, suffix: '', accent: 'pink', icon: 'spark', he: 'יכולות נדל״ן', en: 'Real estate tools' },
  { value: 2, suffix: ' m', accent: 'violet', icon: 'clock', he: 'דף נכס באוויר', en: 'Page live in' },
  { value: 30, suffix: ' d', accent: 'amber', icon: 'clock', he: 'תוקף דף נכס', en: 'Page lifespan' },
  { value: 100, suffix: '%', accent: 'sage', icon: 'globe', he: 'עברית נייטיב', en: 'Hebrew native' },
];
---
<RadialOrbitalTimeline
  items={processSteps}
  eyebrowHe="היכולות של פורלי"
  eyebrowEn="What Forly can do"
  headingHe="שש יכולות. הודעה אחת בעברית."
  headingEn="Six capabilities. One Hebrew message."
/>
<section class="features" id="features">
  <div class="container">
    <header class="features-head" data-reveal-stagger>
      <p class="eyebrow" data-reveal><T he="מה פורלי יוצרת" en="What Forly makes" /></p>
      <h2 class="features-title" data-reveal>
        <span class="l-he">מנהל שיווק <span class="grad">לסוכנים</span><br />שחי בצ׳אט שלכם.</span>
        <span class="l-en">A <span class="grad">marketing manager</span><br />that lives in your chat.</span>
      </h2>
      <p class="features-sub" data-reveal>
        <span class="l-he">שש יכולות ליצירת דפי נכס, סיורי וידאו, וקופירייטינג שיווקי — הכל מנוהל מהוואטסאפ שלכם.</span>
        <span class="l-en">Six capabilities for creating property pages, video tours, and marketing copy — all managed from your WhatsApp.</span>
      </p>
    </header>

    
    <div class="grid">
      {cards.map((c, i) => (
        <article class="card" data-card style={`--i:${i}`}>
          <div class="card-glow" data-card-glow></div>
          <div class="card-content">
            <p class="card-label"><T he={c.label.he} en={c.label.en} /></p>
            <h3 class="card-title"><T he={c.title.he} en={c.title.en} /></h3>
            <p class="card-body"><T he={c.body.he} en={c.body.en} /></p>
            <div class="card-meter">
              <div class="meter-row">
                <span class="meter-label"><T he={c.metricLabel.he} en={c.metricLabel.en} /></span>
                <span class="meter-value" data-meter-value data-target={c.metric}>0%</span>
              </div>
              <div class="meter-track">
                <div class="meter-fill" data-meter-fill data-target={c.metric}></div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Letter-by-letter scramble quote — each language gets its own scramble target. -->
    <blockquote class="scramble" data-scramble-block>
      <p class="scramble-text">
        <span class="l-he" data-scramble>בלי סוכנויות. בלי מעצבים. הכל בוואטסאפ.</span>
        <span class="l-en" data-scramble>No agencies. No designers. Just WhatsApp.</span>
      </p>
      <cite><T he="— התזה של פורלי לנדל״ן" en="— The Forly Real Estate thesis" /></cite>
    </blockquote>

    <!-- Counter strip — four accent-coded cards. Each stat owns a color,
         an icon, and a gradient numeral; hover lifts with a colored glow. -->
    <ul class="stats" data-stats>
      {stats.map((s) => (
        <li class:list={['stat', `stat--${s.accent}`]}>
          <span class="stat-icon" aria-hidden="true">
            {s.icon === 'spark' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3z" />
                <path d="M19 4l.6 1.7L21 6.3l-1.4.6L19 8.6l-.6-1.7L17 6.3l1.4-.6z" />
              </svg>
            )}
            {s.icon === 'palette' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21a9 9 0 110-18 9 9 0 015 16.4c-1.2.8-2.6.4-2.6-1 0-1.5 1.4-1.7 1.4-3 0-1-.9-1.6-2-1.6h-1.5a2 2 0 01-2-2c0-1.4.9-2.4-.3-3.3" />
                <circle cx="7.5" cy="11" r="1" fill="currentColor" />
                <circle cx="11" cy="7.5" r="1" fill="currentColor" />
                <circle cx="15.5" cy="8.5" r="1" fill="currentColor" />
              </svg>
            )}
            {s.icon === 'clock' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3.5 2" />
              </svg>
            )}
            {s.icon === 'globe' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18" />
                <path d="M12 3a14 14 0 010 18" />
                <path d="M12 3a14 14 0 000 18" />
              </svg>
            )}
          </span>
          <span class="stat-num" data-counter data-target={s.value} data-suffix={s.suffix}>0</span>
          <span class="stat-label"><T he={s.he} en={s.en} /></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Light theme — matches the RadialOrbitalTimeline above. Page surface
     (--surface = #fbf5f8) shows through; soft pink/sage radials add depth
     without changing the underlying color story. */
  .features {
    position: relative;
    padding: 160px 0 120px;
    background:
      radial-gradient(800px 600px at 20% 0%, rgba(219, 107, 151, 0.10), transparent 60%),
      radial-gradient(700px 500px at 80% 100%, rgba(127, 168, 155, 0.06), transparent 60%),
      var(--surface);
  }
  .features-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 72px;
    display: grid;
    gap: 18px;
  }
  .features-title {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.05;
    color: var(--ink);
  }
  .grad {
    background: linear-gradient(110deg, var(--forli-pink-soft), var(--forli-pink), var(--forli-pink-deep));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .features-sub {
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 560px;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px)  { .grid { grid-template-columns: 1fr; } }

  .card {
    position: relative;
    border-radius: var(--radius-md);
    padding: 1px;
    background: linear-gradient(180deg, rgba(26, 18, 32, 0.06), rgba(26, 18, 32, 0.02));
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .card-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 50%),
      rgba(219, 107, 151, 0.18),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .card:hover .card-glow { opacity: 1; }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 40px rgba(26, 18, 32, 0.10);
  }

  .card-content {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-radius: calc(var(--radius-md) - 1px);
    padding: 28px 26px 26px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--forli-pink-deep);
  }
  .card-title {
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .card-body {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.55;
    flex: 1;
  }

  .card-meter { display: grid; gap: 8px; margin-top: 6px; }
  .meter-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 12px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }
  .meter-value { color: var(--ink); font-weight: 600; }
  .meter-track {
    height: 4px;
    background: rgba(26, 18, 32, 0.08);
    border-radius: 4px;
    overflow: hidden;
  }
  .meter-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--forli-pink-soft), var(--forli-pink));
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(219, 107, 151, 0.45);
  }

  .scramble {
    margin: 140px auto 120px;
    max-width: 920px;
    text-align: center;
    display: grid;
    gap: 18px;
  }
  .scramble-text {
    font-family: var(--font-display);
    font-size: clamp(28px, 4.4vw, 56px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-shadow: 0 0 50px rgba(219, 107, 151, 0.18);
  }
  .scramble-text .ch { display: inline-block; }
  .scramble-text .ch.live { color: var(--forli-pink); }
  .scramble cite {
    font-style: normal;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Stats — four accent-coded cards. Each card owns a hue via --accent
     custom property and renders an icon, gradient numeral, and label. */
  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    padding: 0;
    margin: 0;
    max-width: 720px;
    margin-inline: auto;
  }

  .stat {
    --accent: var(--forli-pink);
    --accent-soft: rgba(219, 107, 151, 0.12);
    --accent-glow: rgba(219, 107, 151, 0.28);
    --accent-ink: #6e1a3e;
    position: relative;
    padding: 30px 22px 24px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    display: grid;
    gap: 12px;
    justify-items: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
  }
  /* Per-accent tokens. Picked so each hue stays in the warm/Mediterranean
     family and reads as professional rather than gaudy on the rose surface. */
  .stat--pink   { --accent: #db6b97; --accent-soft: rgba(219, 107, 151, 0.14); --accent-glow: rgba(219, 107, 151, 0.30); --accent-ink: #6e1a3e; }
  .stat--violet { --accent: #8b6bbd; --accent-soft: rgba(139, 107, 189, 0.14); --accent-glow: rgba(139, 107, 189, 0.30); --accent-ink: #3d2a66; }
  .stat--amber  { --accent: #d49a4f; --accent-soft: rgba(212, 154, 79, 0.16); --accent-glow: rgba(212, 154, 79, 0.32); --accent-ink: #6b4310; }
  .stat--sage   { --accent: #6d9a8b; --accent-soft: rgba(127, 168, 155, 0.18); --accent-glow: rgba(127, 168, 155, 0.32); --accent-ink: #2c4a3f; }

  /* Top accent stripe */
  .stat::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  /* Soft radial wash that hints at the card hue without overwhelming */
  .stat::after {
    content: '';
    position: absolute;
    inset: -40% -30% auto -30%;
    height: 75%;
    background: radial-gradient(closest-side, var(--accent-soft), transparent 70%);
    z-index: -1;
    pointer-events: none;
  }

  .stat:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 14px 38px var(--accent-glow);
  }

  .stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid color-mix(in oklab, var(--accent) 25%, transparent);
  }
  .stat-icon svg { width: 20px; height: 20px; }

  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    background: linear-gradient(160deg, var(--accent) 0%, var(--accent-ink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 4px 14px var(--accent-glow));
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Reveal stagger on heading
  gsap.utils.toArray<HTMLElement>('[data-reveal-stagger]').forEach((group) => {
    const items = group.querySelectorAll<HTMLElement>('[data-reveal]');
    gsap.from(items, {
      y: 40,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      stagger: 0.1,
      scrollTrigger: { trigger: group, start: 'top 80%' },
    });
  });

  // Card stagger reveal + meter fill on enter
  const cards = gsap.utils.toArray<HTMLElement>('[data-card]');
  if (cards.length) {
    gsap.from(cards, {
      y: 60,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
      stagger: 0.08,
      scrollTrigger: { trigger: cards[0].parentElement, start: 'top 75%' },
    });

    cards.forEach((card) => {
      const fill = card.querySelector<HTMLElement>('[data-meter-fill]');
      const value = card.querySelector<HTMLElement>('[data-meter-value]');
      if (!fill || !value) return;
      const target = Number(fill.dataset.target ?? 0);
      const proxy = { v: 0 };
      ScrollTrigger.create({
        trigger: card,
        start: 'top 80%',
        once: true,
        onEnter: () => {
          gsap.to(fill, { width: `${target}%`, duration: 1.4, ease: 'power3.out' });
          gsap.to(proxy, {
            v: target,
            duration: 1.4,
            ease: 'power3.out',
            onUpdate: () => {
              value.textContent = `${Math.round(proxy.v)}%`;
            },
          });
        },
      });
    });

    // Mouse-following neon glow on card hover
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      });
    });
  }

  // Letter-by-letter scramble reveal — applied independently to each language.
  const chars = '!<>-_\\/[]{}—=+*^?#________';
  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((scrambleEl) => {
    const original = scrambleEl.textContent ?? '';
    scrambleEl.innerHTML = original
      .split('')
      .map((c) => `<span class="ch" data-c="${c.replace(/"/g, '&quot;')}">${c === ' ' ? '&nbsp;' : c}</span>`)
      .join('');
    const spans = scrambleEl.querySelectorAll<HTMLElement>('.ch');

    ScrollTrigger.create({
      trigger: scrambleEl,
      start: 'top 75%',
      once: true,
      onEnter: () => {
        spans.forEach((span, i) => {
          const finalChar = span.dataset.c ?? '';
          if (finalChar === ' ') return;
          let frame = 0;
          const totalFrames = 14 + Math.floor(Math.random() * 8);
          const start = i * 22;
          setTimeout(() => {
            span.classList.add('live');
            const id = setInterval(() => {
              frame++;
              if (frame >= totalFrames) {
                span.textContent = finalChar;
                span.classList.remove('live');
                clearInterval(id);
              } else {
                span.textContent = chars[Math.floor(Math.random() * chars.length)];
              }
            }, 28);
          }, start);
        });
      },
    });
  });

  // Counter strip
  gsap.utils.toArray<HTMLElement>('[data-counter]').forEach((el) => {
    const target = Number(el.dataset.target ?? 0);
    const suffix = el.dataset.suffix ?? '';
    const obj = { v: 0 };
    ScrollTrigger.create({
      trigger: el,
      start: 'top 85%',
      once: true,
      onEnter: () => {
        gsap.to(obj, {
          v: target,
          duration: 1.8,
          ease: 'power3.out',
          onUpdate: () => {
            const n = target >= 1000 ? Math.round(obj.v).toLocaleString() : Math.round(obj.v).toString();
            el.textContent = `${n}${suffix}`;
          },
        });
      },
    });
  });
</script>
