---
import T from './T.astro';
import RadialOrbitalTimeline, { type TimelineItem } from './RadialOrbitalTimeline.astro';

// 6 capabilities Forly ships. Each node is a distinct generation pipeline.
// Connections show which capabilities pair up: image ↔ image-edit,
// video ↔ image-to-video, plus carousels/websites that compose the others.
const processSteps: TimelineItem[] = [
  {
    id: 1,
    iconKey: 'image',
    he: {
      title: 'יצירת תמונה',
      date: '5–10 שניות',
      content: 'משפט אחד בעברית הופך לתמונה מוכנה לפרסום, עם כיתוב והאשטגים מותאמים לטון של העסק שלכם.',
    },
    en: {
      title: 'Create image',
      date: '5–10 seconds',
      content: 'One Hebrew sentence becomes a ready-to-post image, with caption and hashtags matched to your brand voice.',
    },
    status: 'completed',
    relatedIds: [2, 5],
    progress: 100,
  },
  {
    id: 2,
    iconKey: 'image-edit',
    he: {
      title: 'תמונה לתמונה',
      date: 'בלי פוטושופ',
      content: 'שלחו תמונה ובקשה — "תוסיף לי כובע", "תשני את הצבע", "תחליפי רקע" — והפנים שלכם נשארות מזוהות.',
    },
    en: {
      title: 'Image to image',
      date: 'No Photoshop',
      content: 'Send a photo and a request — "add a hat", "change the color", "swap the background" — and your face stays recognizable.',
    },
    status: 'completed',
    relatedIds: [1],
    progress: 96,
  },
  {
    id: 3,
    iconKey: 'video',
    he: {
      title: 'יצירת סרטון',
      date: '10–15 שניות וידאו',
      content: 'משפט אחד הופך לסרטון מיני בן 3 שוטים: פתיחה → תפנית → סיום. רציפות פנימית, סגנון לבחירה.',
    },
    en: {
      title: 'Create video',
      date: '10–15 second clip',
      content: 'One sentence becomes a 3-shot mini-story: setup → turn → payoff. Internal continuity, tone of your choice.',
    },
    status: 'completed',
    relatedIds: [4],
    progress: 90,
  },
  {
    id: 4,
    iconKey: 'video-motion',
    he: {
      title: 'תמונה לסרטון',
      date: 'תנועה בהזמנה',
      content: 'שלחו תמונה. פורלי שואלת "איזו תנועה?" — והתשובה שלכם הופכת לסרטון 3 שוטים שמעוגן בתמונה המקורית.',
    },
    en: {
      title: 'Image to video',
      date: 'Motion on demand',
      content: 'Send an image. Forly asks "what motion?" — your reply becomes a 3-shot video anchored on your photo.',
    },
    status: 'in-progress',
    relatedIds: [3],
    progress: 75,
  },
  {
    id: 5,
    iconKey: 'carousel',
    he: {
      title: 'קרוסלה',
      date: 'אינסטגרם',
      content: '3–5 תמונות מחוברות, מעוצבות לפוסט החלקה — מספרות סיפור אחד, פריים אחר פריים, עם כיתובים מותאמים.',
    },
    en: {
      title: 'Carousel',
      date: 'Instagram swipe',
      content: '3–5 connected images designed as a swipe post — they tell one story frame by frame, captions included.',
    },
    status: 'in-progress',
    relatedIds: [1, 6],
    progress: 60,
  },
  {
    id: 6,
    iconKey: 'website',
    he: {
      title: 'אתר עסק',
      date: 'דף נחיתה',
      content: 'דף עסק נקי שנבנה אוטומטית מהפרופיל שלכם ומכל התוכן שיצרתם — מתעדכן בהודעה אחת.',
    },
    en: {
      title: 'Website',
      date: 'Landing page',
      content: 'A clean business page built automatically from your profile and the content you\'ve created — updates with a single message.',
    },
    status: 'pending',
    relatedIds: [5, 1, 3],
    progress: 35,
  },
];

const cards = [
  {
    label: { he: 'דף נחיתה', en: 'Landing Page' },
    title: { he: 'דף נכס חי תוך דקות', en: 'Live property page in minutes' },
    body: {
      he: 'מזינים פרטים (כתובת, מחיר, חדרים) והמערכת בונה דף נחיתה מעוצב עם טופס לידים מובנה.',
      en: 'Enter details (address, price, rooms) and the system builds a designed landing page with a built-in lead form.',
    },
    metric: 100,
    metricLabel: { he: 'זמינות באוויר', en: 'Uptime' },
  },
  {
    label: { he: 'וידאו AI', en: 'AI Video' },
    title: { he: 'סיור וידאו אוטומטי', en: 'Auto video tour' },
    body: {
      he: 'מעלים תמונות של הנכס ופורלי מייצרת סיור וידאו קולנועי שמשתלב אוטומטית בדף הנכס שלכם.',
      en: 'Upload property photos and Forly generates a cinematic video tour that automatically embeds in your property page.',
    },
    metric: 100,
    metricLabel: { he: 'תמונות לוידאו', en: 'Photos to video' },
  },
  {
    label: { he: 'לידים', en: 'Leads' },
    title: { he: 'ניהול לידים מתקדם', en: 'Advanced lead management' },
    body: {
      he: 'כל פנייה מדף הנכס נכנסת ישירות למערכת הניהול ונשלחת אליכם כהתראה מיידית, כדי שלא תפספסו אף קונה.',
      en: 'Every inquiry from the property page goes straight into the CRM and sends you an instant alert, so you never miss a buyer.',
    },
    metric: 100,
    metricLabel: { he: 'סנכרון בזמן אמת', en: 'Realtime sync' },
  },
  {
    label: { he: 'צ׳אטבוט', en: 'Chatbot' },
    title: { he: 'מענה חכם לקונים', en: 'Smart buyer response' },
    body: {
      he: 'צ׳אטבוט AI משולב בכל דף נכס שעונה על שאלות הקונים 24/7 ואוסף עבורכם פרטי התקשרות.',
      en: 'An AI chatbot embedded in every property page answers buyer questions 24/7 and collects contact info for you.',
    },
    metric: 24,
    metricLabel: { he: 'שעות פעילות', en: 'Hours active' },
  },
  {
    label: { he: 'קופירייטינג', en: 'Copywriting' },
    title: { he: 'טקסט שיווקי שמוכר', en: 'Marketing copy that sells' },
    body: {
      he: 'המערכת כותבת עבורכם תיאור נכס מקצועי ושיווקי בעברית תקנית, המותאם למנועי חיפוש ולרשתות החברתיות.',
      en: 'The system writes a professional marketing description in perfect Hebrew, optimized for search engines and social media.',
    },
    metric: 100,
    metricLabel: { he: 'התאמה לשיווק', en: 'Marketing ready' },
  },
  {
    label: { he: 'שליטה', en: 'Control' },
    title: { he: 'ניהול נכסים פשוט', en: 'Simple property management' },
    body: {
      he: 'אזור ניהול מתקדם שמאפשר לערוך נכסים באוויר, לשנות מחירים, לעדכן תמונות ולנהל את תוקף הדפים בקלות.',
      en: 'An advanced dashboard that lets you edit live properties, change prices, update photos, and manage page expiry easily.',
    },
    metric: 100,
    metricLabel: { he: 'שליטה מלאה', en: 'Full control' },
  },
];

type StatAccent = 'pink' | 'violet' | 'amber' | 'sage';
type StatIcon = 'spark' | 'palette' | 'clock' | 'globe';
const stats: {
  value: number;
  suffix: string;
  accent: StatAccent;
  icon: StatIcon;
  he: string;
  en: string;
}[] = [
  { value: 6, suffix: '', accent: 'pink', icon: 'spark', he: 'כלי נדל״ן מתקדמים', en: 'Real estate tools' },
  { value: 2, suffix: ' m', accent: 'violet', icon: 'clock', he: 'דף נכס באוויר', en: 'Page live in' },
  { value: 30, suffix: ' d', accent: 'amber', icon: 'clock', he: 'תוקף דף נכס', en: 'Page lifespan' },
  { value: 100, suffix: '%', accent: 'sage', icon: 'globe', he: 'עברית נייטיב', en: 'Hebrew native' },
];
---

<section class="features" id="features">
  <div class="container">
    <header class="features-head" data-reveal-stagger>
      <p class="eyebrow" data-reveal><T he="פלטפורמה חכמה" en="Smart Platform" /></p>
      <h2 class="features-title" data-reveal>
        <span class="l-he">הכלים <span class="grad">המתקדמים</span><br />לשיווק נדל״ן.</span>
        <span class="l-en">Advanced <span class="grad">tools</span><br />for real estate marketing.</span>
      </h2>
      <p class="features-sub" data-reveal>
        <span class="l-he">שש יכולות ליצירת דפי נכס, סיורי וידאו, צ׳אטבוט חכם וקופירייטינג שיווקי — הכל בפלטפורמה אחת פשוטה.</span>
        <span class="l-en">Six capabilities for creating property pages, video tours, smart chatbots, and marketing copy — all in one simple platform.</span>
      </p>
    </header>

    
    <div class="grid">
      {cards.map((c, i) => (
        <article class="card" data-card style={`--i:${i}`}>
          <div class="card-glow" data-card-glow></div>
          <div class="card-content">
            <p class="card-label"><T he={c.label.he} en={c.label.en} /></p>
            <h3 class="card-title"><T he={c.title.he} en={c.title.en} /></h3>
            <p class="card-body"><T he={c.body.he} en={c.body.en} /></p>
            <div class="card-meter">
              <div class="meter-row">
                <span class="meter-label"><T he={c.metricLabel.he} en={c.metricLabel.en} /></span>
                <span class="meter-value" data-meter-value data-target={c.metric}>0%</span>
              </div>
              <div class="meter-track">
                <div class="meter-fill" data-meter-fill data-target={c.metric}></div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Letter-by-letter scramble quote — each language gets its own scramble target. -->
    <blockquote class="scramble" data-scramble-block>
      <p class="scramble-text">
        <span class="l-he" data-scramble>בלי סוכנויות. בלי מעצבים. פלטפורמה אחת.</span>
        <span class="l-en" data-scramble>No agencies. No designers. Just one platform.</span>
      </p>
      <cite><T he="— התזה של פורלי לנדל״ן" en="— The Forly Real Estate thesis" /></cite>
    </blockquote>

  </div>
</section>

<section class="organic-marketing">
  <div class="container">
    <header class="organic-head" data-reveal-stagger>
      <p class="eyebrow" data-reveal><T he="שיווק אורגני" en="Organic Marketing" /></p>
      <h2 class="organic-title" data-reveal>
        <span class="l-he">הנכסים שלכם, <span class="grad">בכל מקום.</span></span>
        <span class="l-en">Your properties, <span class="grad">everywhere.</span></span>
      </h2>
      <p class="organic-sub" data-reveal>
        <span class="l-he">פורלי לא רק מייצרת דפי נכס, היא עוזרת לכם להפיץ אותם. בלחיצת כפתור אחת, תוכלו לפרסם את הנכסים שלכם ברשתות החברתיות ובקבוצות.</span>
        <span class="l-en">Forly doesn't just create property pages, it helps you distribute them. With one click, you can publish your properties to social media and groups.</span>
      </p>
    </header>

    <div class="organic-grid">
      <div class="organic-card" data-card>
        <div class="organic-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </div>
        <h3><T he="פייסבוק" en="Facebook" /></h3>
        <p>
          <span class="l-he">פרסמו ישירות לעמוד העסקי שלכם עם תמונות, סרטונים, וטקסט מותאם.</span>
          <span class="l-en">Publish directly to your business page with images, videos, and tailored copy.</span>
        </p>
      </div>
      <div class="organic-card" data-card>
        <div class="organic-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </div>
        <h3><T he="אינסטגרם" en="Instagram" /></h3>
        <p>
          <span class="l-he">יצרו פוסטים, רילס וסטוריז שמושכים תשומת לב, ישר מהמערכת.</span>
          <span class="l-en">Create eye-catching posts, reels, and stories straight from the system.</span>
        </p>
      </div>
      <div class="organic-card" data-card>
        <div class="organic-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h3><T he="קבוצות וקהילות" en="Groups & Communities" /></h3>
        <p>
          <span class="l-he">הפיצו את דפי הנכס שלכם בקבוצות וואטסאפ ופייסבוק בלחיצה.</span>
          <span class="l-en">Distribute your property pages in WhatsApp and Facebook groups with a click.</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Light theme — matches the RadialOrbitalTimeline above. Page surface
     (--surface = #fbf5f8) shows through; soft pink/sage radials add depth
     without changing the underlying color story. */
  .features {
    position: relative;
    padding: 160px 0 120px;
    background: var(--surface);
  }
  .features-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 72px;
    display: grid;
    gap: 18px;
  }
  .features-title {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.05;
    color: var(--ink);
  }
  .grad {
    color: var(--forli-pink);
  }
  .features-sub {
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 560px;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px)  { .grid { grid-template-columns: 1fr; } }

  .card {
    position: relative;
    border-radius: var(--radius-md);
    padding: 1px;
    background: linear-gradient(180deg, rgba(26, 18, 32, 0.06), rgba(26, 18, 32, 0.02));
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .card-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 50%),
      rgba(201, 164, 100, 0.18),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .card:hover .card-glow { opacity: 1; }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 40px rgba(26, 18, 32, 0.10);
  }

  .card-content {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-radius: calc(var(--radius-md) - 1px);
    padding: 28px 26px 26px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--forli-pink-deep);
  }
  .card-title {
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .card-body {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.55;
    flex: 1;
  }

  .card-meter { display: grid; gap: 8px; margin-top: 6px; }
  .meter-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 12px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }
  .meter-value { color: var(--ink); font-weight: 600; }
  .meter-track {
    height: 4px;
    background: rgba(26, 18, 32, 0.08);
    border-radius: 4px;
    overflow: hidden;
  }
  .meter-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--forli-pink-soft), var(--forli-pink));
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(201, 164, 100, 0.45);
  }

  .scramble {
    margin: 140px auto 120px;
    max-width: 920px;
    text-align: center;
    display: grid;
    gap: 18px;
  }
  .scramble-text {
    font-family: var(--font-display);
    font-size: clamp(28px, 4.4vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .scramble-text .ch { display: inline-block; }
  .scramble-text .ch.live { color: var(--forli-pink); }
  .scramble cite {
    font-style: normal;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .organic-marketing {
    padding: 0 0 120px;
    background: var(--surface);
  }
  .organic-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 64px;
    display: grid;
    gap: 18px;
  }
  .organic-title {
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.05;
    color: var(--ink);
  }
  .organic-sub {
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 560px;
    margin: 0 auto;
  }
  .organic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (max-width: 800px) { .organic-grid { grid-template-columns: 1fr; max-width: 400px; } }
  
  .organic-card {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 32px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .organic-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(26, 18, 32, 0.06);
    border-color: rgba(201, 164, 100, 0.4);
  }
  .organic-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: rgba(201, 164, 100, 0.15);
    color: var(--forli-pink);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .organic-icon svg {
    width: 28px;
    height: 28px;
  }
  .organic-card h3 {
    font-size: 20px;
    color: var(--ink);
  }
  .organic-card p {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.5;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Reveal stagger on heading
  gsap.utils.toArray<HTMLElement>('[data-reveal-stagger]').forEach((group) => {
    const items = group.querySelectorAll<HTMLElement>('[data-reveal]');
    gsap.from(items, {
      y: 40,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      stagger: 0.1,
      scrollTrigger: { trigger: group, start: 'top 80%' },
    });
  });

  // Card stagger reveal + meter fill on enter
  const cards = gsap.utils.toArray<HTMLElement>('[data-card]');
  if (cards.length) {
    gsap.from(cards, {
      y: 60,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
      stagger: 0.08,
      scrollTrigger: { trigger: cards[0].parentElement, start: 'top 75%' },
    });

    cards.forEach((card) => {
      const fill = card.querySelector<HTMLElement>('[data-meter-fill]');
      const value = card.querySelector<HTMLElement>('[data-meter-value]');
      if (!fill || !value) return;
      const target = Number(fill.dataset.target ?? 0);
      const proxy = { v: 0 };
      ScrollTrigger.create({
        trigger: card,
        start: 'top 80%',
        once: true,
        onEnter: () => {
          gsap.to(fill, { width: `${target}%`, duration: 1.4, ease: 'power3.out' });
          gsap.to(proxy, {
            v: target,
            duration: 1.4,
            ease: 'power3.out',
            onUpdate: () => {
              value.textContent = `${Math.round(proxy.v)}%`;
            },
          });
        },
      });
    });

    // Mouse-following neon glow on card hover
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      });
    });
  }

  // Letter-by-letter scramble reveal — applied independently to each language.
  const chars = '!<>-_\\/[]{}—=+*^?#________';
  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((scrambleEl) => {
    const original = scrambleEl.textContent ?? '';
    scrambleEl.innerHTML = original
      .split('')
      .map((c) => `<span class="ch" data-c="${c.replace(/"/g, '&quot;')}">${c === ' ' ? '&nbsp;' : c}</span>`)
      .join('');
    const spans = scrambleEl.querySelectorAll<HTMLElement>('.ch');

    ScrollTrigger.create({
      trigger: scrambleEl,
      start: 'top 75%',
      once: true,
      onEnter: () => {
        spans.forEach((span, i) => {
          const finalChar = span.dataset.c ?? '';
          if (finalChar === ' ') return;
          let frame = 0;
          const totalFrames = 14 + Math.floor(Math.random() * 8);
          const start = i * 22;
          setTimeout(() => {
            span.classList.add('live');
            const id = setInterval(() => {
              frame++;
              if (frame >= totalFrames) {
                span.textContent = finalChar;
                span.classList.remove('live');
                clearInterval(id);
              } else {
                span.textContent = chars[Math.floor(Math.random() * chars.length)];
              }
            }, 28);
          }, start);
        });
      },
    });
  });


</script>
