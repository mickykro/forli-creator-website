---
import T from './T.astro';
import { BUSINESS, PLATFORM_SIGNUP_URL, WHATSAPP_QUESTION_URL } from '../brand';

const year = new Date().getFullYear();
---
<section class="cta" id="cta" data-cta>
  <div class="ambient" aria-hidden="true"></div>
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>

  <div class="container cta-inner">
    <h2 class="cta-title" data-cta-line>
      <span class="l-he">מוכנים לשווק<br /><span class="grad">את הנכסים שלכם?</span></span>
      <span class="l-en">Ready to market<br /><span class="grad">your properties?</span></span>
    </h2>
    <p class="cta-sub" data-cta-line>
      <span class="l-he">הרשמה מהירה לפלטפורמה. הזינו את פרטי הנכס הראשון שלכם וקבלו דף נחיתה מוכן תוך דקות.</span>
      <span class="l-en">Quick platform signup. Enter your first property details and get a ready landing page in minutes.</span>
    </p>
    <div class="cta-actions" data-cta-line>
      <a href={WHATSAPP_QUESTION_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
        <T he="להצטרפות כתבו לנו בוואטסאפ" en="Got a question? WhatsApp us" />
      </a>
    </div>
    <div class="cta-contact" data-cta-line>
      <a href={`mailto:${BUSINESS.email}`}>✉ {BUSINESS.email}</a>
      <a href={`tel:${BUSINESS.phoneE164}`} dir="ltr">📞 {BUSINESS.phone}</a>
    </div>
    <p class="cta-foot" data-cta-line>
      <T he="תל אביב, ישראל · לעסקים ישראליים · פרטיות כברירת מחדל" en="Tel Aviv, Israel · Built for Israeli SMBs · Privacy by default" />
    </p>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <span class="brand-name">FORLY · {BUSINESS.legalName}</span>
    <span class="footer-links">
      <a href="/faq"><T he="שאלות ותשובות" en="FAQ" /></a> ·
      <a href="/terms"><T he="תקנון אתר" en="Terms" /></a> ·
      <a href="/privacy"><T he="מדיניות פרטיות" en="Privacy" /></a> ·
      <a href="/accessibility"><T he="הצהרת נגישות" en="Accessibility" /></a>
    </span>
    <span class="footer-copy">
      <T he={`© ${year} פורלי · ${BUSINESS.legalName}. נעשה בתל אביב.`} en={`© ${year} Forly · ${BUSINESS.legalName}. Made in Tel Aviv.`} />
    </span>
  </div>
</footer>

<style>
  .cta {
    position: relative;
    padding: 140px 0 120px;
    overflow: hidden;
    background: var(--aubergine-deep);
    color: var(--rose-bg);
    isolation: isolate;
  }
  .ambient {
    position: absolute;
    inset: -10%;
    z-index: -1;
    background:
      radial-gradient(50% 50% at 50% 50%, rgba(201, 164, 100, 0.15), transparent 60%),
      radial-gradient(40% 40% at 70% 30%, rgba(201, 164, 100, 0.08), transparent 60%);
    filter: blur(60px);
    opacity: 0.95;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -1;
    pointer-events: none;
  }
  .orb-1 {
    width: 520px;
    height: 520px;
    left: -120px;
    top: 10%;
    background: radial-gradient(circle, var(--forli-pink-soft), transparent 70%);
    opacity: 0.35;
    animation: drift 14s ease-in-out infinite;
  }
  .orb-2 {
    width: 460px;
    height: 460px;
    right: -100px;
    bottom: 5%;
    background: radial-gradient(circle, var(--forli-pink-soft), transparent 70%);
    opacity: 0.28;
    animation: drift 16s ease-in-out -4s infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.05); }
  }

  .cta-inner {
    text-align: center;
    display: grid;
    gap: 22px;
    place-items: center;
    max-width: 820px;
  }
  .cta-title {
    font-size: clamp(40px, 6vw, 84px);
    font-weight: 700;
    color: var(--rose-bg);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .grad {
    color: var(--forli-pink);
  }
  .cta-sub {
    color: rgba(244, 236, 223, 0.78);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.55;
    max-width: 600px;
  }
  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }
  .cta-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
    margin-top: 18px;
    color: rgba(244, 236, 223, 0.78);
    font-size: 14px;
  }
  .cta-contact a { transition: color 0.2s ease; }
  .cta-contact a:hover { color: var(--forli-pink); }

  .cta-foot {
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(244, 236, 223, 0.45);
  }

  .footer {
    border-top: 1px solid rgba(230, 207, 159, 0.1);
    padding: 24px 0;
    background: var(--aubergine);
    color: rgba(244, 236, 223, 0.5);
    font-size: 12px;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand-name {
    font-family: var(--font-display);
    letter-spacing: 0.14em;
    color: var(--rose-bg);
  }
  .footer-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .footer-links a { transition: color 0.2s ease; }
  .footer-links a:hover { color: var(--rose-bg); }
  
  @media (max-width: 760px) {
    .footer-inner { flex-direction: column; text-align: center; gap: 12px; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const lines = gsap.utils.toArray<HTMLElement>('[data-cta-line]');
  if (lines.length) {
    gsap.from(lines, {
      y: 50,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      stagger: 0.08,
      scrollTrigger: { trigger: '[data-cta]', start: 'top 70%' },
    });
  }
</script>
