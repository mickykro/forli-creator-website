---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { SITE_URL } from '../../brand';

// Parse product from query string
const url = new URL(Astro.request.url);
const productParam = url.searchParams.get('product') || '';

// Parse: credit_pack_taste, subscription_starter_monthly, etc.
let productType: string;
let productId: string;
let billingCycle: string | undefined;

if (productParam.startsWith('credit_pack_')) {
  productType = 'credit_pack';
  productId = productParam.replace('credit_pack_', '');
  billingCycle = undefined;
} else if (productParam.startsWith('subscription_')) {
  const parts = productParam.replace('subscription_', '').split('_');
  productType = 'subscription';
  productId = parts[0]; // starter, growth, pro
  billingCycle = parts[1]; // monthly, annual
} else {
  return Astro.redirect('/pricing');
}

// Validate product
if (!productType || !productId) {
  return Astro.redirect('/pricing');
}

const actualProductType = productType;
---

<Base
  title="התחברות לתשלום — Forly | Payment Login"
  description="התחבר עם WhatsApp לביצוע תשלום"
  bilingual={true}
>
  <main class="login-flow">
    <div class="container">
      <div class="login-card">
        <!-- Phone Input State -->
        <div id="phoneState" class="state-panel active">
          <h1 class="title">
            <span class="l-he">התחברות מהירה</span>
            <span class="l-en">Quick Login</span>
          </h1>
          <p class="subtitle">
            <span class="l-he">נשלח לך קוד בוואטסאפ</span>
            <span class="l-en">We'll send you a code via WhatsApp</span>
          </p>

          <form id="phoneForm">
            <div class="form-group">
              <label for="phone">
                <span class="l-he">מספר טלפון</span>
                <span class="l-en">Phone Number</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+972-54-XXX-XXXX"
                required
                dir="ltr"
                autocomplete="tel"
              />
            </div>

            <div id="phoneError" class="error-message" role="alert"></div>

            <button type="submit" class="btn btn-primary btn-block" id="sendOtpBtn">
              <span class="l-he">שלח קוד</span>
              <span class="l-en">Send Code</span>
            </button>
          </form>
        </div>

        <!-- OTP Verification State -->
        <div id="otpState" class="state-panel">
          <h1 class="title">
            <span class="l-he">הזן קוד אימות</span>
            <span class="l-en">Enter Verification Code</span>
          </h1>
          <p class="subtitle">
            <span class="l-he">שלחנו קוד ל-<span id="maskedPhone"></span></span>
            <span class="l-en">We sent a code to <span id="maskedPhone"></span></span>
          </p>
          <p class="hint">
            <span class="l-he">או לחץ על הקישור בוואטסאפ להתחברות אוטומטית</span>
            <span class="l-en">Or click the link in WhatsApp for automatic login</span>
          </p>

          <form id="otpForm">
            <div class="form-group">
              <div class="otp-inputs" dir="ltr">
                <input type="text" maxlength="1" class="otp-digit" data-index="0" dir="ltr" inputmode="numeric" autocomplete="one-time-code" />
                <input type="text" maxlength="1" class="otp-digit" data-index="1" dir="ltr" inputmode="numeric" autocomplete="off" />
                <input type="text" maxlength="1" class="otp-digit" data-index="2" dir="ltr" inputmode="numeric" autocomplete="off" />
                <input type="text" maxlength="1" class="otp-digit" data-index="3" dir="ltr" inputmode="numeric" autocomplete="off" />
                <input type="text" maxlength="1" class="otp-digit" data-index="4" dir="ltr" inputmode="numeric" autocomplete="off" />
                <input type="text" maxlength="1" class="otp-digit" data-index="5" dir="ltr" inputmode="numeric" autocomplete="off" />
              </div>
            </div>

            <div class="form-group">
              <label for="promoCode">
                <span class="l-he">קוד קופון (אופציונלי)</span>
                <span class="l-en">Promo Code (Optional)</span>
              </label>
              <div class="promo-input-group">
                <input
                  type="text"
                  id="promoCode"
                  name="promoCode"
                  placeholder="FREE100"
                  dir="ltr"
                  autocomplete="off"
                />
                <button type="button" class="btn-apply" id="applyPromoBtn">
                  <span class="l-he">בדוק</span>
                  <span class="l-en">Apply</span>
                </button>
              </div>
              <div id="promoMessage" class="promo-message" role="status"></div>
            </div>

            <div id="otpError" class="error-message" role="alert"></div>

            <button type="submit" class="btn btn-primary btn-block" id="verifyOtpBtn">
              <span class="l-he">אמת קוד</span>
              <span class="l-en">Verify Code</span>
            </button>

            <div class="actions">
              <button type="button" class="btn-link" id="resendBtn" disabled>
                <span class="l-he">שלח שוב (<span id="countdown">30</span>)</span>
                <span class="l-en">Resend (<span id="countdown">30</span>)</span>
              </button>
              <button type="button" class="btn-link" id="changePhoneBtn">
                <span class="l-he">שנה מספר</span>
                <span class="l-en">Change number</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="state-panel">
          <div class="spinner"></div>
          <p class="loading-text">
            <span class="l-he">מעביר לתשלום...</span>
            <span class="l-en">Redirecting to payment...</span>
          </p>
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  .login-flow {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: radial-gradient(50% 50% at 50% 50%, rgba(219, 107, 151, 0.08), transparent),
                var(--surface);
  }

  .login-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px rgba(26, 18, 32, 0.08);
    padding: 48px 32px;
    max-width: 400px;
    width: 100%;
  }

  .state-panel {
    display: none;
  }

  .state-panel.active {
    display: block;
  }

  .title {
    font-size: 28px;
    font-weight: 800;
    color: var(--ink);
    text-align: center;
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 15px;
    color: var(--ink-soft);
    text-align: center;
    margin-bottom: 32px;
  }

  .hint {
    font-size: 13px;
    color: var(--sage);
    text-align: center;
    margin-bottom: 24px;
    font-weight: 500;
  }

  .form-group {
    margin-bottom: 20px;
  }

  label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }

  input[type="tel"] {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    font-size: 16px;
    transition: border-color 0.2s;
  }

  input[type="tel"]:focus {
    outline: none;
    border-color: var(--forli-pink);
  }

  .otp-inputs {
    display: flex;
    gap: 8px;
    justify-content: center;
  }

  .otp-digit {
    width: 48px;
    height: 56px;
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    transition: border-color 0.2s;
  }

  .otp-digit:focus {
    outline: none;
    border-color: var(--forli-pink);
  }

  .error-message {
    display: none;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    padding: 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    margin-bottom: 16px;
  }

  .error-message.visible {
    display: block;
  }

  .promo-input-group {
    display: flex;
    gap: 8px;
  }

  .promo-input-group input {
    flex: 1;
    padding: 12px 14px;
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    font-size: 14px;
    text-transform: uppercase;
    transition: border-color 0.2s;
  }

  .promo-input-group input:focus {
    outline: none;
    border-color: var(--forli-pink);
  }

  .btn-apply {
    padding: 12px 20px;
    background: var(--surface-soft);
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-apply:hover {
    background: var(--forli-pink);
    border-color: var(--forli-pink);
    color: white;
  }

  .btn-apply:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .promo-message {
    display: none;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    margin-top: 8px;
  }

  .promo-message.visible {
    display: block;
  }

  .promo-message.success {
    background: #f0fdf4;
    border: 1px solid #86efac;
    color: #166534;
  }

  .promo-message.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
  }

  .btn-block {
    width: 100%;
    padding: 16px;
    font-size: 16px;
    font-weight: 700;
  }

  .actions {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
  }

  .btn-link {
    background: none;
    border: none;
    color: var(--forli-pink);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    padding: 4px;
  }

  .btn-link:disabled {
    color: var(--ink-soft);
    cursor: not-allowed;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--line);
    border-top-color: var(--forli-pink);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 24px;
  }

  .loading-text {
    text-align: center;
    color: var(--ink-soft);
    font-size: 15px;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 32px 24px;
    }

    .otp-digit {
      width: 40px;
      height: 48px;
      font-size: 20px;
    }
  }
</style>

<script define:vars={{ productType: actualProductType, productId, billingCycle }}>
  let currentPhone = '';

  // State management
  function showState(stateName) {
    document.querySelectorAll('.state-panel').forEach(panel => panel.classList.remove('active'));
    document.getElementById(stateName)?.classList.add('active');
  }

  function showError(containerId, message) {
    const el = document.getElementById(containerId);
    if (el) {
      el.textContent = message;
      el.classList.add('visible');
    }
  }

  function hideError(containerId) {
    const el = document.getElementById(containerId);
    if (el) {
      el.classList.remove('visible');
    }
  }

  // Phone form submission
  const phoneForm = document.getElementById('phoneForm');
  phoneForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError('phoneError');

    const phone = document.getElementById('phone').value.trim();
    const btn = document.getElementById('sendOtpBtn');
    btn.disabled = true;
    btn.textContent = 'שולח...';

    try {
      const response = await fetch('/api/auth/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          phone,
          productType,
          productId,
          billingCycle: billingCycle || null,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to send OTP');
      }

      currentPhone = result.phone; // Use normalized phone from backend
      document.getElementById('maskedPhone').textContent = result.maskedPhone;
      showState('otpState');
      document.querySelector('.otp-digit').focus();
      startCountdown();
    } catch (error) {
      showError('phoneError', error.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span class="l-he">שלח קוד</span><span class="l-en">Send Code</span>';
    }
  });

  // OTP input handling
  const otpInputs = document.querySelectorAll('.otp-digit');

  // Handle paste - allow pasting full 6-digit code
  otpInputs.forEach((input, index) => {
    input.addEventListener('paste', (e) => {
      e.preventDefault();
      const pastedData = e.clipboardData.getData('text');
      const digits = pastedData.replace(/\D/g, '').slice(0, 6); // Extract only digits, max 6

      if (digits.length === 6) {
        // Fill all inputs
        digits.split('').forEach((digit, i) => {
          if (otpInputs[i]) {
            otpInputs[i].value = digit;
          }
        });
        // Focus the verify button so user can easily submit
        document.getElementById('verifyOtpBtn')?.focus();
      } else if (digits.length > 0) {
        // Fill from current input onwards
        digits.split('').forEach((digit, i) => {
          if (otpInputs[index + i]) {
            otpInputs[index + i].value = digit;
          }
        });
        // Focus next empty or last
        const nextIndex = Math.min(index + digits.length, 5);
        otpInputs[nextIndex].focus();
      }
    });

    input.addEventListener('input', (e) => {
      if (e.target.value.length === 1 && index < 5) {
        otpInputs[index + 1].focus();
      } else if (e.target.value.length === 1 && index === 5) {
        // Last digit filled - focus verify button
        document.getElementById('verifyOtpBtn')?.focus();
      }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !e.target.value && index > 0) {
        otpInputs[index - 1].focus();
      }
    });
  });

  // Promo code validation
  let promoCodeData = null;

  function showPromoMessage(message, type) {
    const el = document.getElementById('promoMessage');
    if (el) {
      el.textContent = message;
      el.className = `promo-message visible ${type}`;
    }
  }

  function hidePromoMessage() {
    const el = document.getElementById('promoMessage');
    if (el) {
      el.className = 'promo-message';
    }
  }

  document.getElementById('applyPromoBtn')?.addEventListener('click', async () => {
    const input = document.getElementById('promoCode');
    const code = input.value.trim().toUpperCase();
    const btn = document.getElementById('applyPromoBtn');

    if (!code) {
      showPromoMessage('Please enter a promo code', 'error');
      return;
    }

    btn.disabled = true;
    btn.textContent = '...';
    hidePromoMessage();

    try {
      const response = await fetch('/api/promo/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code,
          productType,
          productId,
          billingCycle: billingCycle || null,
        }),
      });

      const result = await response.json();
      console.log('Promo validation result:', result);

      if (!result.valid) {
        console.error('Promo code invalid:', result.error);
        showPromoMessage(result.error || 'Invalid promo code', 'error');
        promoCodeData = null;
      } else {
        promoCodeData = {
          code,
          originalPrice: result.originalPrice,
          discountAmount: result.discountAmount,
          finalPrice: result.finalPrice,
        };

        const lang = document.documentElement.lang;
        const discountText = result.discountType === 'percentage'
          ? `${result.discountValue}% ${lang === 'he' ? 'הנחה' : 'off'}`
          : `₪${result.discountAmount} ${lang === 'he' ? 'הנחה' : 'off'}`;

        if (result.finalPrice === 0) {
          showPromoMessage(
            lang === 'he' ? `✓ חינם! ${discountText}` : `✓ Free! ${discountText}`,
            'success'
          );
        } else {
          showPromoMessage(
            lang === 'he'
              ? `✓ ${discountText} - ₪${result.finalPrice} במקום ₪${result.originalPrice}`
              : `✓ ${discountText} - ₪${result.finalPrice} instead of ₪${result.originalPrice}`,
            'success'
          );
        }

        input.disabled = true;
        btn.style.display = 'none';
      }
    } catch (error) {
      console.error('Promo validation error:', error);
      showPromoMessage(error.message || 'Failed to validate promo code', 'error');
      promoCodeData = null;
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span class="l-he">בדוק</span><span class="l-en">Apply</span>';
    }
  });

  // Allow Enter key to apply promo
  document.getElementById('promoCode')?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      document.getElementById('applyPromoBtn').click();
    }
  });

  // OTP form submission
  const otpForm = document.getElementById('otpForm');
  otpForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError('otpError');

    const otp = Array.from(otpInputs).map(inp => inp.value).join('');
    const btn = document.getElementById('verifyOtpBtn');
    btn.disabled = true;
    btn.textContent = 'מאמת...';

    try {
      const response = await fetch('/api/auth/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: currentPhone, otp }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Invalid OTP');
      }

      // Success - show loading and redirect to payment
      showState('loadingState');

      const paymentBody = {
        productType: result.productType,
        productId: result.productId,
        billingCycle: result.billingCycle,
      };

      // Add promo code data if applied
      if (promoCodeData) {
        paymentBody.promoCode = promoCodeData.code;
        paymentBody.discountAmount = promoCodeData.discountAmount;
        paymentBody.finalPrice = promoCodeData.finalPrice;
      }

      const paymentResponse = await fetch('/api/payment/create-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(paymentBody),
      });

      const paymentResult = await paymentResponse.json();

      if (!paymentResponse.ok) {
        throw new Error(paymentResult.error || 'Failed to create payment');
      }

      window.location.href = paymentResult.paymentUrl;
    } catch (error) {
      showError('otpError', error.message);
      btn.disabled = false;
      btn.innerHTML = '<span class="l-he">אמת קוד</span><span class="l-en">Verify Code</span>';
    }
  });

  // Resend OTP with countdown
  let countdownInterval;
  function startCountdown() {
    let seconds = 30;
    const resendBtn = document.getElementById('resendBtn');
    const countdownEl = document.getElementById('countdown');

    countdownInterval = setInterval(() => {
      seconds--;
      countdownEl.textContent = seconds;

      if (seconds <= 0) {
        clearInterval(countdownInterval);
        resendBtn.disabled = false;
        resendBtn.innerHTML = '<span class="l-he">שלח שוב</span><span class="l-en">Resend</span>';
      }
    }, 1000);
  }

  document.getElementById('resendBtn')?.addEventListener('click', () => {
    phoneForm.requestSubmit();
  });

  // Change phone
  document.getElementById('changePhoneBtn')?.addEventListener('click', () => {
    otpInputs.forEach(inp => inp.value = '');
    hideError('otpError');
    showState('phoneState');
    if (countdownInterval) clearInterval(countdownInterval);
  });
</script>
</Base>
