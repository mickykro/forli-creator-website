---
/* call4li.com — buyer-facing property catalog.
   SSR-first: listings fetched server-side from the Forly backend portal API.
   If the API is unreachable the page renders skeletons and the client script
   below retries, then shows an error panel. The same client script handles
   realtime add/update/remove over SSE and the phone-reveal analytics. */
import Portal from '../layouts/Portal.astro';
import PortalNav from '../components/portal/PortalNav.astro';
import PortalHero from '../components/portal/PortalHero.astro';
import FilterBar from '../components/portal/FilterBar.astro';
import PropertyCard from '../components/portal/PropertyCard.astro';
import AreaTiles from '../components/portal/AreaTiles.astro';
import ValueStrip from '../components/portal/ValueStrip.astro';
import AgentBand from '../components/portal/AgentBand.astro';
import PortalFooter from '../components/portal/PortalFooter.astro';
import { getPortalData, isNew, areaSummaries, deriveTags, PORTAL_API_BASE } from '../lib/portal';
import { SITE_URL } from '../brand';

const { ok, listings, agencies, cities } = await getPortalData();

const featured = ok ? listings.filter(isNew).slice(0, 3) : [];
const featuredIds = new Set(featured.map((l) => l.page_id));
const rest = ok ? listings.filter((l) => !featuredIds.has(l.page_id)) : [];

const neighborhoods = [...new Set(listings.map((l) => l.neighborhood).filter(Boolean))].sort(
  (a, b) => a.localeCompare(b, 'he'),
);
const areas = areaSummaries(listings);
// Quick-filter chips: the most common tags across the listings, most first.
const tagCounts = new Map<string, number>();
for (const l of listings) for (const t of deriveTags(l)) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
const presentTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6).map(([t]) => t);

const itemListSchema = ok
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'קטלוג הנכסים של פורלי',
      numberOfItems: listings.length,
      itemListElement: listings.slice(0, 20).map((l, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: l.title || l.address,
        url: l.page_url,
      })),
    }
  : undefined;
---
<Portal schema={itemListSchema}>
  <PortalNav />
  <PortalHero listingCount={ok ? listings.length : null} agencyCount={ok ? agencies.length : null} />
  <FilterBar
    cities={cities}
    neighborhoods={neighborhoods}
    agencies={agencies}
    tags={presentTags}
    total={ok ? listings.length : null}
  />

  <main data-portal-state={ok ? 'ready' : 'loading'}>
    <section class="sect container" id="new-sect" style={featured.length === 0 ? 'display:none' : undefined}>
      <div class="sect-head">
        <h2>חדשים השבוע</h2>
        <span class="sub">נוצרו בפורלי בימים האחרונים</span>
      </div>
      <div class="row-featured" id="featured">
        {featured.map((l) => <PropertyCard listing={l} />)}
      </div>
    </section>

    <section class="sect container">
      <div class="sect-head">
        <h2>כל הנכסים</h2>
        <div class="sortbox">
          <label for="sort">מיון</label>
          <select id="sort">
            <option value="new">חדשים קודם</option>
            <option value="price-asc">מחיר: מהנמוך</option>
            <option value="price-desc">מחיר: מהגבוה</option>
            <option value="size">גודל</option>
          </select>
        </div>
      </div>
      <div class="pgrid" id="grid">
        {ok
          ? rest.map((l) => <PropertyCard listing={l} />)
          : Array.from({ length: 6 }).map(() => (
              <div class="skel" aria-hidden="true">
                <div class="s-media"></div>
                <div class="s-line"></div>
                <div class="s-line short"></div>
              </div>
            ))}
      </div>
      <p class="empty" id="empty-grid">לא נמצאו נכסים שמתאימים לסינון — נסו להרחיב את החיפוש.</p>
      <div class="error-panel" id="error-panel">
        <h3>הקטלוג לא זמין כרגע</h3>
        <p>לא הצלחנו לטעון את הנכסים. בדקו את החיבור ונסו שוב.</p>
        <button class="btn" type="button" id="retry-btn">נסו שוב</button>
      </div>
    </section>

    <AreaTiles areas={areas} />
    <ValueStrip />
  </main>

  <AgentBand agencies={agencies} />
  <PortalFooter />

  <div class="toast-region" aria-live="polite" id="toast-region"></div>

  <!-- Client-side card blueprint. KEEP IN SYNC with PropertyCard.astro -->
  <template id="card-tpl">
    <article class="card">
      <a href="#" class="media" target="_blank" rel="noopener">
        <img class="t-poster" alt="" loading="lazy" />
        <span class="badges"><span class="badge-new">חדש</span></span>
        <span class="views">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" /><circle cx="12" cy="12" r="2.6" /></svg>
          <span class="t-views"></span>
        </span>
        <span class="play">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z" /></svg>
          סיור וידאו
        </span>
      </a>
      <div class="card-body">
        <div class="price-row"><span class="price"></span><span class="ppm"></span></div>
        <div class="meta"></div>
        <div class="addr"><span class="t-street"></span><span class="t-area"></span></div>
        <div class="tags"></div>
        <div class="card-foot">
          <span class="agent-chip"><i></i><span class="t-agent"></span></span>
          <span class="foot-side">
            <span class="fresh"></span>
            <button type="button" class="phone-btn">הצגת טלפון</button>
          </span>
        </div>
      </div>
    </article>
  </template>

  <script is:inline define:vars={{ API_BASE: PORTAL_API_BASE, SSR_OK: ok, SITE_URL }}>
    (function () {
      var NEW_MS = 7 * 86400000;
      var main = document.querySelector('main');
      var grid = document.getElementById('grid');
      var featuredEl = document.getElementById('featured');
      var tpl = document.getElementById('card-tpl');
      var filters = function () { return window.__portalFilters || { apply: function () {}, setOptions: function () {}, setCats: function () {} }; };

      /* ── tiny JS twins of the server-side presentation helpers ── */
      function fmtPrice(p) { return p > 0 ? '₪' + Number(p).toLocaleString('en-US') : 'מחיר בתיאום'; }
      function ppm(l) { return l.price && l.size_sqm ? '₪' + (l.price / l.size_sqm / 1000).toFixed(1) + 'K למ״ר' : ''; }
      function fmtViews(n) { return n >= 1000 ? (n / 1000).toFixed(1) + 'K' : String(n); }
      function isNew(l) { return !!l.created_at && Date.now() - new Date(l.created_at).getTime() < NEW_MS; }
      function fresh(l) {
        if (!l.created_at) return '';
        var d = Math.floor((Date.now() - new Date(l.created_at).getTime()) / 86400000);
        if (d <= 0) return 'עלה היום';
        if (d === 1) return 'עלה אתמול';
        if (d === 2) return 'עלה לפני יומיים';
        if (d < 7) return 'עלה לפני ' + d + ' ימים';
        if (d < 14) return 'שבוע בשוק';
        if (d < 30) return Math.floor(d / 7) + ' שבועות בשוק';
        var m = Math.floor(d / 30);
        return m === 1 ? 'חודש בשוק' : m + ' חודשים בשוק';
      }
      function metaLine(l) {
        var p = [];
        if (l.rooms) p.push(l.rooms + ' חד׳');
        if (l.size_sqm) p.push(l.size_sqm + ' מ״ר');
        if (l.floor !== null && l.floor > 0) p.push('קומה ' + l.floor);
        return p.join(' · ');
      }
      var KW = [[/פנטהאוז/, 'פנטהאוז'], [/דירת גן|גינה/, 'גן'], [/מרפסת/, 'מרפסת'],
        [/נוף לים|ליד הים|קו ראשון/, 'ים'], [/דופלקס/, 'דופלקס'], [/בלעדיות/, 'בלעדיות'], [/משופצ/, 'משופצת']];
      function deriveTags(l) {
        if (l.tags && l.tags.length) return l.tags;
        var text = (l.title || '') + ' ' + (l.neighborhood || '');
        var tags = [];
        KW.forEach(function (kw) { if (kw[0].test(text) && tags.indexOf(kw[1]) < 0) tags.push(kw[1]); });
        if (l.parking > 0 && tags.indexOf('חניה') < 0) tags.push('חניה');
        return tags;
      }

      function buildCard(l) {
        var node = tpl.content.firstElementChild.cloneNode(true);
        var tags = deriveTags(l);
        node.dataset.pageId = l.page_id;
        node.dataset.city = l.city || '';
        node.dataset.hood = l.neighborhood || '';
        node.dataset.street = l.address || '';
        node.dataset.rooms = String(l.rooms || 0);
        node.dataset.price = String(l.price || 0);
        node.dataset.size = String(l.size_sqm || 0);
        node.dataset.agent = (l.agent && l.agent.brand_name) || '';
        node.dataset.new = isNew(l) ? '1' : '0';
        node.dataset.tags = tags.join(' ');
        node.dataset.phone = (l.agent && l.agent.phone) || '';

        var media = node.querySelector('.media');
        media.href = l.page_url || '#';
        media.setAttribute('aria-label', 'דף הנכס: ' + (l.title || l.address || ''));
        var img = node.querySelector('.t-poster');
        if (l.poster_url) { img.src = l.poster_url; img.alt = l.title || l.address || ''; }
        else img.remove();
        if (!isNew(l)) node.querySelector('.badges').remove();
        if (l.view_count > 0) node.querySelector('.t-views').textContent = fmtViews(l.view_count);
        else node.querySelector('.views').remove();

        node.querySelector('.price').textContent = fmtPrice(l.price);
        var ppmEl = node.querySelector('.ppm');
        var ppmText = ppm(l);
        if (ppmText) ppmEl.textContent = ppmText; else ppmEl.remove();
        var metaEl = node.querySelector('.meta');
        var meta = metaLine(l);
        if (meta) metaEl.textContent = meta; else metaEl.remove();
        node.querySelector('.t-street').textContent = l.address || '';
        var areaBits = [l.neighborhood, l.city].filter(Boolean).join(', ');
        node.querySelector('.t-area').textContent = areaBits ? ' · ' + areaBits : '';
        var tagsEl = node.querySelector('.tags');
        tags.forEach(function (t) {
          var s = document.createElement('span');
          s.className = 'tag';
          s.textContent = t;
          tagsEl.appendChild(s);
        });
        var chip = node.querySelector('.agent-chip i');
        if (l.agent && l.agent.logo_url) {
          var li = document.createElement('img');
          li.src = l.agent.logo_url; li.alt = '';
          chip.appendChild(li);
        } else {
          chip.textContent = ((l.agent && (l.agent.brand_name || l.agent.name)) || 'פ').trim().charAt(0);
        }
        node.querySelector('.t-agent').textContent =
          [(l.agent && l.agent.name), (l.agent && l.agent.brand_name)].filter(Boolean).join(' · ');
        var freshEl = node.querySelector('.fresh');
        var fl = fresh(l);
        if (fl) freshEl.textContent = fl; else freshEl.remove();
        if (!(l.agent && l.agent.phone)) node.querySelector('.phone-btn').remove();
        return node;
      }

      /* ── stats + counters ── */
      function refreshCounts() {
        var cards = document.querySelectorAll('.card').length;
        var st = document.getElementById('stat-listings');
        var tot = document.getElementById('total');
        if (st) st.textContent = String(cards);
        if (tot) tot.textContent = String(cards);
        filters().apply();
      }

      /* ── toast ── */
      function toast(text) {
        var region = document.getElementById('toast-region');
        if (!region) return;
        var t = document.createElement('div');
        t.className = 'toast';
        t.textContent = text;
        region.appendChild(t);
        setTimeout(function () { t.remove(); }, 4000);
      }

      /* ── full render (client-load path after SSR failure) ── */
      function renderAll(data) {
        var listings = data.listings || [];
        grid.querySelectorAll('.skel, .card').forEach(function (el) { el.remove(); });
        featuredEl.querySelectorAll('.card').forEach(function (el) { el.remove(); });
        var featured = listings.filter(isNew).slice(0, 3);
        var featuredIds = featured.map(function (l) { return l.page_id; });
        featured.forEach(function (l) { featuredEl.appendChild(buildCard(l)); });
        listings.forEach(function (l) {
          if (featuredIds.indexOf(l.page_id) < 0) grid.appendChild(buildCard(l));
        });
        document.getElementById('new-sect').style.display = featured.length ? '' : 'none';
        var stA = document.getElementById('stat-agencies');
        if (stA) stA.textContent = String((data.agencies || []).length);
        var hoods = [];
        listings.forEach(function (l) { if (l.neighborhood && hoods.indexOf(l.neighborhood) < 0) hoods.push(l.neighborhood); });
        filters().setOptions(data.cities || [], hoods.sort(), data.agencies || []);
        var counts = {};
        listings.forEach(function (l) { deriveTags(l).forEach(function (t) { counts[t] = (counts[t] || 0) + 1; }); });
        var topTags = Object.keys(counts).sort(function (a, b) { return counts[b] - counts[a]; }).slice(0, 6);
        filters().setCats(topTags);
        main.dataset.portalState = 'ready';
        document.getElementById('error-panel').classList.remove('on');
        refreshCounts();
      }

      function showError() {
        grid.querySelectorAll('.skel').forEach(function (el) { el.remove(); });
        main.dataset.portalState = 'error';
        document.getElementById('error-panel').classList.add('on');
      }

      function fetchListings(attempt) {
        fetch(API_BASE + '/api/portal/listings')
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
          .then(renderAll)
          .catch(function () {
            if (attempt < 2) setTimeout(function () { fetchListings(attempt + 1); }, 1500);
            else showError();
          });
      }
      document.getElementById('retry-btn').addEventListener('click', function () {
        main.dataset.portalState = 'loading';
        document.getElementById('error-panel').classList.remove('on');
        for (var i = 0; i < 6; i++) {
          var sk = document.createElement('div');
          sk.className = 'skel';
          sk.setAttribute('aria-hidden', 'true');
          sk.innerHTML = '<div class="s-media"></div><div class="s-line"></div><div class="s-line short"></div>';
          grid.appendChild(sk);
        }
        fetchListings(0);
      });
      if (!SSR_OK) fetchListings(0);

      /* ── realtime: add / update / remove ── */
      function findCard(pageId) {
        return document.querySelector('.card[data-page-id="' + (window.CSS ? CSS.escape(pageId) : pageId) + '"]');
      }
      function onAdded(l) {
        var existing = findCard(l.page_id);
        if (existing) return onUpdated(l);
        var card = buildCard(l);
        card.classList.add('flash');
        document.getElementById('new-sect').style.display = '';
        featuredEl.prepend(card);
        refreshCounts();
        toast('נכס חדש עלה עכשיו');
      }
      function onUpdated(l) {
        var existing = findCard(l.page_id);
        if (!existing) return onAdded(l);
        var card = buildCard(l);
        card.classList.add('flash');
        existing.replaceWith(card);
        refreshCounts();
      }
      function onRemoved(data) {
        var existing = findCard(data.page_id);
        if (existing) { existing.remove(); refreshCounts(); }
      }
      function parse(handler) {
        return function (e) {
          try { handler(JSON.parse(e.data)); } catch (err) { /* ignore malformed frame */ }
        };
      }
      try {
        var es = new EventSource(API_BASE + '/api/portal/stream');
        es.addEventListener('listing_added', parse(onAdded));
        es.addEventListener('listing_updated', parse(onUpdated));
        es.addEventListener('listing_removed', parse(onRemoved));
      } catch (err) { /* EventSource unavailable — polling below covers it */ }

      // Polling fallback: catches anything the stream missed.
      setInterval(function () {
        if (main.dataset.portalState !== 'ready') return;
        fetch(API_BASE + '/api/portal/listings')
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var seen = {};
            (data.listings || []).forEach(function (l) {
              seen[l.page_id] = true;
              if (!findCard(l.page_id)) grid.appendChild(buildCard(l));
            });
            document.querySelectorAll('.card[data-page-id]').forEach(function (c) {
              if (!seen[c.dataset.pageId]) c.remove();
            });
            refreshCounts();
          })
          .catch(function () {});
      }, 60000);

      /* ── phone reveal (delegated — works for realtime cards too) ── */
      document.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('.phone-btn');
        if (!btn) return;
        var card = btn.closest('.card');
        var phone = card && card.dataset.phone;
        if (!phone) return;
        var a = document.createElement('a');
        a.className = 'phone-link';
        a.href = 'tel:' + phone.replace(/[^+\d]/g, '');
        a.textContent = phone;
        btn.replaceWith(a);
        try {
          var payload = JSON.stringify({ page_id: card.dataset.pageId, event: 'phone_reveal' });
          if (navigator.sendBeacon) navigator.sendBeacon(API_BASE + '/api/property-event', payload);
          else fetch(API_BASE + '/api/property-event', { method: 'POST', body: payload, keepalive: true });
        } catch (err) { /* analytics is best-effort */ }
      });
    })();
  </script>
</Portal>
