---
import Legal from '../layouts/Legal.astro';
import { WHATSAPP_HELLO_URL } from '../brand';

const faqs = [
  {
    question: 'מה זה פורלי?',
    answer:
      'פורלי היא מנהל שיווק AI לסוכני נדל״ן. היא מאפשרת לכם לייצר דפי נכס, סיורי וידאו וטקסטים שיווקיים בהודעת וואטסאפ אחת או דרך המערכת. כל הלידים שמגיעים מדפי הנכס נשלחים ישירות לנייד שלכם.',
  },
  {
    question: 'איך מקימים דף נכס?',
    answer:
      'שולחים הודעה בוואטסאפ עם פרטי הנכס (כתובת, חדרים, מחיר) או מזינים אותם במערכת הניהול. פורלי מייצרת אוטומטית דף נחיתה מעוצב עם קופירייטינג שיווקי וגלריית תמונות תוך דקות.',
  },
  {
    question: 'האם אפשר להוסיף סיור וידאו?',
    answer:
      'כן. פורלי יכולה לייצר סיור וידאו אוטומטי מבוסס AI מהתמונות שתעלו, או שתוכלו להעלות סיור וידאו שצילמתם בעצמכם. הוידאו ישולב אוטומטית בדף הנכס.',
  },
  {
    question: 'איך אני מקבל את הלידים?',
    answer:
      'כל דף נכס כולל טופס יצירת קשר. ברגע שלקוח פוטנציאלי משאיר פרטים, אתם מקבלים הודעת וואטסאפ מיידית עם השם והטלפון שלו, מוכנים לשיחה.',
  },
  {
    question: 'כמה זמן דף הנכס נשאר באוויר?',
    answer:
      'כל דף נכס פעיל ל-30 יום. 5 ימים לפני תום התוקף, פורלי תשלח לכם תזכורת בוואטסאפ עם כפתור להארכה בחינם ל-30 ימים נוספים.',
  },
  {
    question: 'האם אפשר לערוך את דף הנכס אחרי שהוא באוויר?',
    answer:
      'בהחלט. אזור הניהול מאפשר לכם לשנות מחיר, להחליף תמונות או לעדכן את הטקסט השיווקי. השינויים מתעדכנים בדף הנכס באופן מיידי.',
  },
  {
    question: 'האם צריך אפליקציה או דשבורד מורכב?',
    answer:
      'פורלי עובדת גם מהוואטסאפ וגם מאזור ניהול פשוט ונוח. אין צורך להוריד אפליקציה או ללמוד מערכות מסובכות.',
  },
  {
    question: 'כמה זמן לוקח להתחיל?',
    answer:
      'ההצטרפות לוקחת פחות מדקה. נרשמים עם מספר טלפון, ומיד אפשר להתחיל לייצר את דף הנכס הראשון שלכם.',
  },
  {
    question: 'מה קורה למידע שאני שולח לפורלי?',
    answer:
      'המידע שאתם שולחים משמש אך ורק ליצירת דפי הנכס שלכם. אנחנו שומרים על פרטיות מלאה ולא משתפים את הלידים או המידע שלכם עם אף גורם חיצוני.',
  },
  {
    question: 'איך יוצרים קשר עם הצוות?',
    answer:
      'הדרך המהירה ביותר היא בוואטסאפ. אפשר גם לפנות אלינו במייל info@call4li.com או בטלפון.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---
<Legal
  title="שאלות ותשובות — Forly · פורלי"
  description="מצאו תשובות לשאלות הנפוצות על פורלי — מנהל השיווק AI לסוכני נדל״ן. איך מקימים דפי נכס, איך מקבלים לידים, ואיך מצטרפים."
  heading="שאלות ותשובות"
  schema={faqSchema}
>
  <p style="margin-bottom: 28px;">
    הכל מה שרציתם לדעת על פורלי — מנהל השיווק לסוכני נדל״ן שעובד בוואטסאפ. אם לא מצאתם תשובה לשאלה שלכם,
    <a href={WHATSAPP_HELLO_URL} target="_blank" rel="noopener noreferrer">דברו איתנו ישירות בוואטסאפ</a>.
  </p>

  <div class="faq-list">
    {faqs.map((faq, i) => (
      <details class="faq-item" {...(i === 0 ? { open: true } : {})}>
        <summary>{faq.question}</summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </div>

  <section class="faq-cta">
    <h2>עוד שאלות?</h2>
    <p>צוות פורלי זמין בוואטסאפ — תשובה אנושית, באמת, תוך יום עסקים.</p>
    <a href={WHATSAPP_HELLO_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
      דברו איתנו בוואטסאפ
    </a>
  </section>
</Legal>

<style>
  .faq-list {
    display: grid;
    gap: 12px;
    margin-bottom: 48px;
  }
  .faq-item {
    border: 1px solid var(--line);
    background: var(--surface-soft);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .faq-item[open] {
    border-color: rgba(219, 107, 151, 0.35);
    box-shadow: 0 4px 24px rgba(219, 107, 151, 0.08);
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--forli-pink-deep);
    transition: transform 0.2s ease;
    font-size: 22px;
    line-height: 1;
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p {
    margin: 14px 0 0;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .faq-cta {
    text-align: center;
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 36px 24px;
  }
  .faq-cta h2 { margin-bottom: 10px; }
  .faq-cta p { margin-bottom: 18px; color: var(--ink-soft); }
</style>
